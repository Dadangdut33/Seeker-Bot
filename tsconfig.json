{
  "compilerOptions": {
    "target": "es2020",
    "module": "CommonJS",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "rootDir": "./src",
    "outDir": "./prod",
    "resolveJsonModule": true,
    "allowJs": true,
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "useUnknownInCatchVariables": false,
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules"]
}
